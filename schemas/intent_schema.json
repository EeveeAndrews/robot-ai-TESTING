{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Robot Intent Schema",
  "type": "object",
  "required": ["intent", "description", "examples", "behavior"],
  "properties": {
    "intent": {
      "type": "string",
      "description": "The name of the intent."
    },
    "description": {
      "type": "string",
      "description": "A brief description of what this intent represents."
    },
    "examples": {
      "type": "array",
      "description": "Examples of verbal user input that may indicate this intent.",
      "items": { "type": "string" }
    },
    "behavior": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/behaviorState" }
    },
    "security": {
      "type": "object",
      "description": "Security requirements for protected actions.",
      "properties": {
        "requires_authentication": { "type": "boolean" },
        "authentication_methods": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["facial_recognition", "voice_recognition", "pin", "password"]
          }
        },
        "minimum_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  },
  "$defs": {
    "behaviorState": {
      "type": "object",
      "required": ["response", "action"],
      "properties": {
        "response": { "type": "string" },
        "action": {
          "type": ["object", "null"],
          "required": ["action_type"],
          "properties": {
            "action_type": { "type": "string" },
            "intensity": { "type": "number", "minimum": 0, "maximum": 1 },
            "duration_seconds": { "type": "number", "minimum": 0, "maximum": 30 }
          },
          "additionalProperties": false
        },
        "next_state": { "type": "string" }
      }
    }
  }
}