{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Robot Intent Schema",
  "type": "object",
  "required": ["intent", "description", "examples", "behavior"],
  "properties": {
    "intent": {
      "type": "string",
      "description": "The name of the intent."
    },
    "description": {
      "type": "string",
      "description": "A brief description of what this intent represents."
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "text": { "type": "string" },
          "topic": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "behavior": { "$ref": "#/$defs/behaviorState" },
    "security": {
      "type": "object",
      "description": "Security requirements for protected actions.",
      "properties": {
        "requires_authentication": { "type": "boolean" },
        "authentication_methods": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["facial_recognition", "voice_recognition", "pin", "password"]
          }
        },
        "minimum_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  },
  "$defs": {
    "behaviorState": {
      "type": "object",
      "required": ["responses", "action"],
      "properties": {
        "responses": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "action": {
            "type": ["object", "null"],
            "required": ["action_type"],
            "properties": {
              "action_type": { "type": "string" },
              "intensity": { "type": "number", "minimum": 0, "maximum": 1 },
              "duration_seconds": { "type": "number", "minimum": 0, "maximum": 30 }
            },
            "additionalProperties": false
          },
          "next_state": { "type": "string" }},
        "next_state": { "type": "string" }
    }
  }
}